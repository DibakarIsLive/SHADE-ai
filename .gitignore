# =============================================================================
# SHADE-ai repository ignore policy
# =============================================================================
# Keep source, documentation, dependency manifests, and lockfiles trackable.
# Ignore only local secrets, generated output, caches, runtime evidence, and
# machine-specific tooling files.

# -----------------------------------------------------------------------------
# Python, Django, and test tooling
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.pytype/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.hypothesis/
.pytest_cache/
pytestdebug.log

# Python environments and local interpreter metadata
.venv/
venv/
env/
ENV/
.conda/
.python-version
pip-wheel-metadata/
*.egg-info/
dist/
build/
.eggs/

# Django-generated and local database files
*.log
*.log.*
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
app/staticfiles/
app/media/
local_settings.py

# -----------------------------------------------------------------------------
# Environment files, credentials, and local secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!app/.env.example
!web/.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/

# -----------------------------------------------------------------------------
# JavaScript, Node, React, and Vite
# -----------------------------------------------------------------------------
node_modules/
web/node_modules/
web/dist/
web/.vite/
.vite/
.parcel-cache/
.cache/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Do not ignore package-lock.json, yarn.lock, pnpm-lock.yaml, or npm manifests.

# -----------------------------------------------------------------------------
# SHADE runtime data and computer-vision artifacts
# -----------------------------------------------------------------------------
runtime/
app/runtime/
runtime/evidence/
app/runtime/evidence/
logs/
app/logs/
reports/
app/reports/
model-artifacts/
app/model-artifacts/
weights/
checkpoints/
experiments/
outputs/
artifacts/

# Model weights and compiled inference artifacts
*.onnx
*.onnx.data
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.pb
*.tflite
*.safetensors
*.weights
*.engine
*.bin

# Large media and raw capture files should remain outside Git by default
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wav
*.mp3
*.flac
*.jpg
*.jpeg
*.png
*.webp
*.tif
*.tiff
# The supplied dashboard branding is intentionally trackable at repository root.
!public/
!public/Logo.png
!public/Banner.png
# Keep explicitly documented UI assets if they are later added under web/src.
!web/src/assets/
!web/src/assets/**

# MongoDB local exports and dumps
mongodb-dump/
mongo-dump/
*.bson
*.bson.gz
*.archive

# -----------------------------------------------------------------------------
# Jupyter, notebooks, and machine-learning experiment output
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb
wandb/
mlruns/
.mlflow/
.tensorboard/
tensorboard/

# -----------------------------------------------------------------------------
# Operating system, editor, and IDE files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*.swn
*~

# -----------------------------------------------------------------------------
# Temporary scripts, profiling, and generated reports
# -----------------------------------------------------------------------------
tempCodeRunnerFile.py
*.tmp
*.temp
*.bak
*.orig
*.rej
*.prof
*.lprof
*.pstats
profile/
coverage.xml
junit.xml
reports/

# -----------------------------------------------------------------------------
# Packaging, deployment, and local infrastructure output
# -----------------------------------------------------------------------------
*.pid
*.pid.lock
*.seed
.Docker/
.docker/
docker-data/
.terraform/
.venv
