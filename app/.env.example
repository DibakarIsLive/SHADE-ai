# Django
DJANGO_ENV=development
SECRET_KEY=replace-this-development-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# MongoDB / MongoEngine
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=shade_ai
MONGODB_SERVER_SELECTION_TIMEOUT_MS=500
MONGODB_CONNECT_TIMEOUT_MS=500
MONGODB_SOCKET_TIMEOUT_MS=1000

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Monitoring and evidence boundaries
MONITORING_MODE=synthetic
VISION_PROVIDER=development-null
VISION_DEVICE=cpu
VISION_MODEL_PATH=model-artifacts/vision/rtmo-s/model.onnx
VISION_CONFIDENCE_THRESHOLD=0.25
VISION_KEYPOINT_THRESHOLD=0.2
CAMERA_FRAME_INTERVAL_SECONDS=0.1
EVIDENCE_DIR=runtime/evidence
EVIDENCE_RETENTION_DAYS=7
LOG_LEVEL=INFO

# Safe notification defaults
NOTIFICATION_MODE=dry-run
NOTIFICATION_RECIPIENT=
